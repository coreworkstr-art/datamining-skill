{
  "name": "datamining-skill",
  "displayName": "DataMining Skill",
  "version": "0.2.0",
  "description": "Extract data, such as e-mail addresses, from very large CSV, JSON, JSON Lines and log files on your own machine: profile a file, mine it into a result and check the result. An interrupted run resumes where it stopped.",
  "author": {
    "name": "DataMining Skill Contributors"
  },
  "homepage": "https://github.com/coreworkstr-art/datamining-skill",
  "repository": "https://github.com/coreworkstr-art/datamining-skill",
  "license": "MIT",
  "keywords": ["data-mining", "csv", "jsonl", "logs", "email-extraction", "mcp", "local-first", "privacy"],
  "mcpServers": {
    "datamining": {
      "command": "uvx",
      "args": [
        "--from",
        "${CLAUDE_PLUGIN_ROOT}",
        "datamining-skill",
        "mcp",
        "--allow-dir",
        "${CLAUDE_PROJECT_DIR}"
      ]
    }
  }
}
